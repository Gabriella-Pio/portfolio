# ============================================
# Default: auto-detect text files and
# normalize line endings to LF on commit
# ============================================
* text=auto eol=lf

# ============================================
# Explicitly text files (always LF)
# ============================================
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.mjs       text eol=lf
*.json      text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.md        text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.env       text eol=lf
*.gitignore text eol=lf

# ============================================
# Binary files (never diff/merge)
# ============================================
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.webp   binary
*.svg    text eol=lf

# ============================================
# Lock files — no diff noise
# ============================================
package-lock.json  -diff
pnpm-lock.yaml     -diff
yarn.lock          -diff
